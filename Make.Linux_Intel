# Baseline compiler/library reference, not proof of a new build.
# Copy into pristine HPL 2.3; if building, use:
# make -j1 arch=Linux_Intel HPL_TOPDIR="$PWD"
# Deliver the actual Make file used for the selected binary.
SHELL = /bin/sh
ARCH = Linux_Intel
TOPdir = $(HPL_TOPDIR)
INCdir = $(TOPdir)/include
BINdir = $(TOPdir)/bin/$(ARCH)
LIBdir = $(TOPdir)/lib/$(ARCH)
HPLlib = $(LIBdir)/libhpl.a
MPdir = $(I_MPI_ROOT)
MPinc = -I$(MPdir)/include
MPlib = $(MPdir)/lib/libmpi.so
LAdir = $(MKLROOT)
LAinc = -I$(LAdir)/include
LAlib = $(LAdir)/lib/intel64/libmkl_intel_lp64.so \
        $(LAdir)/lib/intel64/libmkl_sequential.so \
        $(LAdir)/lib/intel64/libmkl_core.so
F2CDEFS =
HPL_OPTS = -DHPL_CALL_CBLAS
HPL_INCLUDES = -I$(INCdir) -I$(INCdir)/$(ARCH) $(LAinc) $(MPinc)
HPL_DEFS = $(F2CDEFS) $(HPL_OPTS) $(HPL_INCLUDES)
HPL_LIBS = $(HPLlib) $(MPlib) $(LAlib) -lpthread -lm -ldl
CC = mpiicc
CCNOOPT = $(HPL_DEFS)
CCFLAGS = $(HPL_DEFS) -O3 -xCORE-AVX512 -ipo -fno-alias -restrict
LINKER = $(CC)
LINKFLAGS = $(CCFLAGS)
CD = cd
CP = cp
LN_S = ln -s -f
MKDIR = mkdir -p
RM = /bin/rm -f
TOUCH = touch
ARCHIVER = ar
ARFLAGS = r
RANLIB = echo
